{
  "info": {
    "_postman_id": "2e26a746-24e2-4f95-8e6f-2fd8b89c9e5a",
    "name": "VoteTrust API",
    "description": "End-to-end Postman collection for the VoteTrust secure voting API. Import with the VoteTrust Local environment and follow the folder order for a demo run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Health and Demo Setup",
      "item": [
        {
          "name": "Initialize Demo Variables",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = new Date();",
                  "const stamp = now.toISOString().replace(/[-:.TZ]/g, '').slice(0, 14);",
                  "pm.environment.set('demoRunId', stamp);",
                  "pm.environment.set('voterEmail', `voter+${stamp}@example.com`);",
                  "pm.environment.set('districtCode', `WC-${stamp.slice(-8)}`);",
                  "pm.environment.set('districtName', `Cape Town Demo Ward ${stamp.slice(-4)}`);",
                  "pm.environment.set('electionName', `VoteTrust Demo Election ${stamp}`);",
                  "pm.environment.set('contestName', `Ward 12 Councillor ${stamp}`);",
                  "",
                  "function southAfricanCheckDigit(first12) {",
                  "  let oddPositionSum = 0;",
                  "  for (let index = 0; index < 12; index += 2) {",
                  "    oddPositionSum += Number(first12[index]);",
                  "  }",
                  "  let evenPositionDigits = '';",
                  "  for (let index = 1; index < 12; index += 2) {",
                  "    evenPositionDigits += first12[index];",
                  "  }",
                  "  const doubledEvenDigitSum = String(Number(evenPositionDigits) * 2)",
                  "    .split('')",
                  "    .reduce((sum, digit) => sum + Number(digit), 0);",
                  "  return (10 - ((oddPositionSum + doubledEvenDigitSum) % 10)) % 10;",
                  "}",
                  "",
                  "const sequence = String(Date.now() % 10000).padStart(4, '0');",
                  "const first12 = `900101${sequence}08`;",
                  "pm.environment.set('voterSouthAfricanIdNumber', `${first12}${southAfricanCheckDigit(first12)}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is reachable', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Demo variables were generated', function () {",
                  "  pm.expect(pm.environment.get('demoRunId')).to.not.be.empty;",
                  "  pm.expect(pm.environment.get('voterSouthAfricanIdNumber')).to.have.length(13);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "Run this first. It generates unique demo data for the current Postman run."
          },
          "response": []
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health"
          },
          "response": []
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health/readiness"
          },
          "response": []
        },
        {
          "name": "OpenAPI JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api-docs"
          },
          "response": []
        }
      ]
    },
    {
