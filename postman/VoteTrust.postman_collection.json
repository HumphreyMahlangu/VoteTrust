    },
    {
      "name": "05 - Results and Audit",
      "item": [
        {
          "name": "Timing Check - Voting Window Closed",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const votingEndAt = new Date(pm.environment.get('votingEndAt')).getTime();",
                  "const waitMs = votingEndAt - Date.now();",
                  "if (waitMs > 0) {",
                  "  console.warn(`Wait ${Math.ceil(waitMs / 1000)} seconds before closing and auditing results.`);",
                  "}",
                  "pm.test('Voting window has ended', function () {",
                  "  pm.expect(Date.now()).to.be.greaterThan(votingEndAt);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "If this fails, wait until votingEndAt and run it again."
          },
          "response": []
        },
        {
          "name": "Transition Contest to CLOSED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CLOSED\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/elections/{{electionId}}/contests/{{contestId}}/status"
          },
          "response": []
        },
        {
          "name": "Transition Election to COMPLETED",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/elections/{{electionId}}/status"
          },
          "response": []
        },
        {
          "name": "Get Final Results",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/elections/{{electionId}}/contests/{{contestId}}/results"
          },
          "response": []
        },
        {
          "name": "Verify Hash Chain",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/elections/{{electionId}}/contests/{{contestId}}/audit"
          },
          "response": []
        },
        {
          "name": "List Public Ledger",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/elections/{{electionId}}/contests/{{contestId}}/ledger"
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Public Reads and Admin Audit",
      "item": [
        {
          "name": "List Voting Districts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/voting-districts"
          },
          "response": []
        },
        {
          "name": "List Elections",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/elections"
          },
          "response": []
        },
        {
          "name": "Get Election",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/elections/{{electionId}}"
          },
          "response": []
        },
        {
          "name": "List Contests",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/elections/{{electionId}}/contests"
          },
          "response": []
        },
        {
          "name": "Admin Security Audit Events",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/security-audit-events?limit=25"
          },
          "response": []
        }
      ]
    },
    {
      "name": "07 - Negative Checks",
      "item": [
        {
          "name": "Invalid Login Returns 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{voterEmail}}\",\n  \"password\": \"WrongPassword1\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "response": []
        },
        {
          "name": "Duplicate Credential Returns 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{voterToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/elections/{{electionId}}/contests/{{contestId}}/credentials",
            "description": "Run after Issue Voting Credential. The same voter cannot receive a second credential for the same contest."
          },
          "response": []
        },
        {
          "name": "Reuse Voting Credential Returns 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contestId\": \"{{contestId}}\",\n  \"contestOptionId\": \"{{optionBId}}\",\n  \"votingCredential\": \"{{votingCredential}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/ballots",
            "description": "Run after successfully casting a ballot."
          },
          "response": []
        },
        {
          "name": "Invalid Voting Credential Returns 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contestId\": \"{{contestId}}\",\n  \"contestOptionId\": \"{{optionAId}}\",\n  \"votingCredential\": \"not-a-real-credential\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/ballots"
          },
          "response": []
        }
      ]
    }
  ]
}
