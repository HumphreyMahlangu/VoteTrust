        {
          "name": "Create Election",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const now = Date.now();",
                  "const registrationWindowMinutes = Math.max(1, Number(pm.environment.get('registrationWindowMinutes') || 2));",
                  "const votingWindowMinutes = Math.max(1, Number(pm.environment.get('votingWindowMinutes') || 5));",
                  "const registrationStartAt = new Date(now - 60000);",
                  "const registrationEndAt = new Date(now + registrationWindowMinutes * 60000);",
                  "const votingStartAt = new Date(registrationEndAt.getTime());",
                  "const votingEndAt = new Date(votingStartAt.getTime() + votingWindowMinutes * 60000);",
                  "pm.environment.set('registrationStartAt', registrationStartAt.toISOString());",
                  "pm.environment.set('registrationEndAt', registrationEndAt.toISOString());",
                  "pm.environment.set('votingStartAt', votingStartAt.toISOString());",
                  "pm.environment.set('votingEndAt', votingEndAt.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Election created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.environment.set('electionId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{electionName}}\",\n  \"type\": \"MUNICIPAL\",\n  \"registrationStartAt\": \"{{registrationStartAt}}\",\n  \"registrationEndAt\": \"{{registrationEndAt}}\",\n  \"votingStartAt\": \"{{votingStartAt}}\",\n  \"votingEndAt\": \"{{votingEndAt}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/elections",
            "description": "Creates a short demo election. Register the voter before registrationEndAt, then wait until votingStartAt before issuing a credential."
          },
