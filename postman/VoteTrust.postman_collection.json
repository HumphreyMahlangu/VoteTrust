          "name": "Bootstrap First Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin created or bootstrap already used', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('adminToken', json.accessToken);",
                  "  pm.environment.set('adminUserId', json.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-VoteTrust-Bootstrap-Token",
                "value": "{{adminBootstrapToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/bootstrap",
            "description": "Run once when the database is new and VOTETRUST_ADMIN_BOOTSTRAP_ENABLED=true. If this returns 409, run Login Admin."
          },
          "response": []
